{
  "$schema": "https://vicinae.com/schemas/config.json",
  "telemetry": {
    "system_info": false
  },
  "input_server": {
    "enabled": true
  },
  "search_files_in_root": false,
  "activate_on_single_click": false,
  "escape_key_behavior": "navigate_back",
  "pop_on_backspace": true,
  "close_on_focus_loss": true,
  "pop_to_root_on_close": true,
  "favicon_service": "twenty",
  "keybinding": "default",
  "font": {
    "rendering": "native",
    "normal": {
      "family": "JetBrainsMono Nerd Font",
      "size": 11.5
    }
  },
  "theme": {
    "light": {
      "name": "understory",
      "icon_theme": "breeze-dark"
    },
    "dark": {
      "name": "understory",
      "icon_theme": "breeze-dark"
    }
  },
  "launcher_window": {
    "opacity": 0.97,
    "material": "blur",
    "rounding": 14,
    "clock": {
      "enabled": true,
      "format": "hh:mm",
      "interval": 60
    },
    "client_side_decorations": {
      "enabled": true,
      "border_width": 1,
      "shadow_size": 14
    },
    "compact_mode": {
      "enabled": false
    },
    "size": {
      "width": 770,
      "height": 480
    },
    "layer_shell": {
      "enabled": true,
      "keyboard_interactivity": "on_demand",
      "layer": "top"
    }
  },
  "favorites": [
    "clipboard:history"
  ],
  "fallbacks": [
    "files:search"
  ],
  "providers": {}
}
